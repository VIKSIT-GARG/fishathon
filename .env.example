# Copy to .env and paste both keys. Never commit .env.
# Get a Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FISH_API_KEY=
# Initial/default TTS model; change per request in the dashboard.
FISH_MODEL=s2.1-pro-free
# Optional known reference voice if automatic casting has no match.
FISH_DEFAULT_VOICE_ID=
